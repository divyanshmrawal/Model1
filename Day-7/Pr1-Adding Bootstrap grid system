<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bootstrap Grid System Only</title>
    <!-- Bootstrap 5 CSS CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/dist/激活.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    
    <!-- Optional: Inline styles just to make the grid columns visible -->
    <style>
        .grid-demo {
            background-color: #f8f9fa;
            border: 1px dashed #dee2e6;
            padding: 20px 0;
            margin-bottom: 20px;
        }
        .col-demo {
            background-color: #e9ecef;
            border: 1px solid #ced4da;
            padding: 15px;
            text-align: center;
            border-radius: 4px;
        }
    </style>
</head>
<body>

    <!-- 1. Fixed Width Container -->
    <div class="container grid-demo">
        <h2 class="text-center mb-4">Standard Container (.container)</h2>
        
        <!-- Row 1: Equal Width Columns -->
        <div class="row mb-3">
            <div class="col">
                <div class="col-demo">Equal Column 1</div>
            </div>
            <div class="col">
                <div class="col-demo">Equal Column 2</div>
            </div>
            <div class="col">
                <div class="col-demo">Equal Column 3</div>
            </div>
        </div>

        <!-- Row 2: Explicit Column Widths (Must equal 12) -->
        <div class="row mb-3">
            <div class="col-6">
                <div class="col-demo">Half Width (.col-6)</div>
            </div>
            <div class="col-4">
                <div class="col-demo">One Third (.col-4)</div>
            </div>
            <div class="col-2">
                <div class="col-demo">One Sixth (.col-2)</div>
            </div>
        </div>

        <!-- Row 3: Responsive Breakpoints -->
        <!-- Stacked on mobile, 2 columns on medium (tablet), 4 columns on large screens -->
        <div class="row">
            <div class="col-md-6 col-lg-3 mb-2">
                <div class="col-demo">Responsive Box 1</div>
            </div>
            <div class="col-md-6 col-lg-3 mb-2">
                <div class="col-demo">Responsive Box 2</div>
            </div>
            <div class="col-md-6 col-lg-3 mb-2">
                <div class="col-demo">Responsive Box 3</div>
            </div>
            <div class="col-md-6 col-lg-3 mb-2">
                <div class="col-demo">Responsive Box 4</div>
            </div>
        </div>
    </div>

    <hr>

    <!-- 2. Full Width Container -->
    <div class="container-fluid grid-demo">
        <h2 class="text-center mb-4">Fluid Container (.container-fluid)</h2>
        
        <div class="row">
            <div class="col-8">
                <div class="col-demo">Main Content Area (.col-8)</div>
            </div>
            <div class="col-4">
                <div class="col-demo">Sidebar Area (.col-4)</div>
            </div>
        </div>
    </div>

    <!-- Bootstrap 5 JS Bundle (Optional, but included for completeness) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
</body>
</html>
